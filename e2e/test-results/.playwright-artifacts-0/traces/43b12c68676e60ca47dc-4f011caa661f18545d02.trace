tion","content":"中国 54 城 · 377 条线路 · 8180 站点：🌌 全国星图总览 + 3D 呈现地下埋深与越江隧道（含京张高铁八达岭长城站 -102 米——世界最深高铁站）+ 港珠澳、深中通道等 11 座超级桥梁三维模型。"}],"\n",["META",{"property":"og:image","content":"https://xn--888-vw3e05fxyzc07e.cn:9006/web/metro3d/poster/og-cover.jpg"}],"\n",["META",{"property":"og:image:width","content":"1200"}],"\n",["META",{"property":"og:image:height","content":"630"}],"\n",["META",{"property":"og:url","content":"https://xn--888-vw3e05fxyzc07e.cn:9006/web/metro3d/"}],"\n",["META",{"property":"og:locale","content":"zh_CN"}],"\n",["META",{"name":"twitter:card","content":"summary_large_image"}],"\n",["META",{"name":"twitter:title","content":"城市地铁与超级桥梁 · 三维立体视图"}],"\n",["META",{"name":"twitter:description","content":"中国 54 城 · 377 条线路 · 8180 站点：🌌 全国星图总览 + 3D 呈现地下埋深与越江隧道（含京张高铁八达岭长城站 -102 米——世界最深高铁站）+ 港珠澳、深中通道等 11 座超级桥梁三维模型。"}],"\n",["META",{"name":"twitter:image","content":"https://xn--888-vw3e05fxyzc07e.cn:9006/web/metro3d/poster/og-cover.jpg"}],"\n\n",["TITLE",{},"中国城市地铁与超级桥梁 · 三维立体视图 · 54 城线网"],"\n",["STYLE",{},"\n  :root{\n    --panel-bg: rgba(var(--panel-rgb), 0.78);\n    --panel-border: rgba(var(--border-rgb), 0.18);\n    --text: #dceaf7;\n    --text-dim: #8fb0c9;\n    --accent: #4FC2E8;\n    --radius: 14px;\n    --panel-rgb: 8, 18, 34;\n    --border-rgb: 110, 190, 255;\n    --input-rgb: 20, 40, 66;\n    --drop-rgb: 10, 22, 40;\n    --body-bg: #050a13;\n    --toast-bg: rgba(var(--panel-rgb), 0.92);\n  }\n  :root[data-theme=\"light\"]{\n    --panel-bg: rgba(var(--panel-rgb), 0.86);\n    --panel-border: rgba(var(--border-rgb), 0.30);\n    --text: #1a2a3a;\n    --text-dim: #5a708a;\n    --accent: #0768a8;   /* v2.2.0 无障碍：原 #0a84d0 在浅底仅 3.2~3.9:1，加深至 ~5:1 */\n    --panel-rgb: 255, 255, 255;\n    --border-rgb: 60, 100, 150;\n    --input-rgb: 240, 245, 250;\n    --drop-rgb: 255, 255, 255;\n    --body-bg: #e8edf3;\n    --toast-bg: rgba(var(--panel-rgb), 0.96);\n  }\n  :root[data-theme=\"light\"] .chip.u{ color:#0a8a5c; border-color:rgba(10,138,92,.45); }\n  :root[data-theme=\"light\"] .chip.e{ color:#a56d00; border-color:rgba(165,109,0,.45); }\n  :root[data-theme=\"light\"] .chip.t{ color:#2a62c0; border-color:rgba(42,98,192,.45); }\n  :root[data-theme=\"light\"] .lg-row, :root[data-theme=\"light\"] #stat-line{ color:var(--text-dim); }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ width:100%; height:100%; overflow:hidden; }\n  body{\n    font-family:\"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",system-ui,sans-serif;\n    background:var(--body-bg); color:var(--text);\n  }\n  #c{ position:fixed; inset:0; display:block; touch-action:none; }\n\n  /* ---------- 通用面板 ---------- */\n  .panel{\n    position:fixed; z-index:10;\n    background:var(--panel-bg);\n    border:1px solid var(--panel-border);\n    border-radius:var(--radius);\n    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);\n    box-shadow: 0 8px 32px rgba(0,0,0,.45);\n    padding:12px 14px;\n  }\n\n  /* ---------- 顶部标题/图例 ---------- */\n  #panel-title{ top:14px; left:14px; width:300px; max-width:calc(100vw - 28px); }\n  #panel-title h1{ font-size:16px; font-weight:700; letter-spacing:.5px; display:flex; align-items:center; gap:8px; }\n  #panel-title h1 .dot{ width:10px; height:10px; border-radius:50%; background:var(--accent); box-shadow:0 0 10px var(--accent); flex:none; }\n  .sel-row{ display:flex; gap:8px; margin-top:10px; }\n  .sel-row select{\n    flex:1; min-width:0; background:rgba(var(--input-rgb), .9); color:var(--text);\n    border:1px solid var(--panel-border); border-radius:8px; padding:5px 6px; font-size:12px; outline:none;\n  }\n  #stat-line{ margin-top:9px; font-size:11.5px; color:var(--text-dim); line-height:1.6; }\n  #stat-line b{ color:var(--text); font-weight:600; }\n  #legend{ margin-top:9px; padding-top:9px; border-top:1px dashed rgba(var(--border-rgb), .15); font-size:11px; }\n  .lg-row{ display:flex; align-items:center; gap:7px; margin-top:5px; color:var(--text-dim); }\n  .lg-chip{ width:22px; height:5px; border-radius:3px; flex:none; }\n  .lg-grad{ width:110px; height:7px; border-radius:4px; flex:none; }\n  .lg-num{ display:flex; justify-content:space-between; width:110px; font-size:10px; color:var(--text-dim); }\n  .lg-ring{ width:9px; height:9px; border-radius:50%; border:2px solid #fff; flex:none; }\n\n  /* ---------- 控制面板 ---------- */\n  #panel-ctrl{ top:14px; right:14px; width:236px; max-width:calc(100vw - 28px); }\n  #panel-ctrl h2{ font-size:12.5px; color:var(--text-dim); font-weight:600; letter-spacing:1px; margin-bottom:8px; }\n  .ctrl-slider-row{ display:flex; align-items:center; gap:8px; font-size:11.5px; }\n  .ctrl-slider-row input[type=range]{ flex:1; accent-color:var(--accent); height:14px; }\n  #vscale-val{ width:44px; text-align:right; color:var(--accent); font-variant-numeric:tabular-nums; }\n  .btn-row{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }\n  .btn{\n    flex:1; min-width:calc(50% - 6px);\n    background:rgba(var(--input-rgb), .75); color:var(--text-dim);\n    border:1px solid var(--panel-border); border-radius:8px;\n    padding:6px 4px; font-size:11.5px; cursor:pointer;\n    transition:all .18s; white-space:nowrap;\n  }\n  .btn:hover{ color:var(--text); border-color:rgba(var(--border-rgb), .45); }\n  .btn.on{ background:rgba(79,194,232,.16); color:var(--accent); border-color:rgba(79,194,232,.55); }\n\n  /* ---------- 站点列表 ---------- */\n  #panel-list{ top:14px; right:266px; width:228px; max-height:calc(100vh - 120px); display:flex; flex-direction:column; }\n  #panel-list h2{ font-size:12.5px; color:var(--text-dim); font-weight:600; letter-spacing:1px; margin-bottom:6px; flex:none; }\n  #st-list{ overflow-y:auto; overscroll-behavior:contain; margin-right:-6px; padding-right:6px; }\n  #st-list::-webkit-scrollbar{ width:4px; }\n  #st-list::-webkit-scrollbar-thumb{ background:rgba(var(--border-rgb), .25); border-radius:2px; }\n  .st-row{\n    display:flex; align-items:center; gap:7px; width:100%;\n    padding:6px 6px; border:0; border-radius:8px; background:transparent;\n    color:var(--text); font-size:12px; cursor:pointer; text-align:left; font-family:inherit;\n  }\n  .st-row:hover{ background:rgba(79,194,232,.1); }\n  .st-row.active{ background:rgba(79,194,232,.18); outline:1px solid rgba(79,194,232,.4); }\n  .st-idx{ color:var(--text-dim); font-size:10px; width:18px; flex:none; font-variant-numeric:tabular-nums; }\n  .st-name{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .st-tr{ font-size:9px; color:var(--text-dim); background:rgba(140,170,200,.15); border-radius:4px; padding:1px 3px; flex:none; }\n  .st-depth{ font-size:10px; flex:none; min-width:38px; text-align:right; font-variant-numeric:tabular-nums; }\n\n  /* ---------- 信息卡 ---------- */\n  #info-card{ left:14px; bottom:52px; width:280px; max-width:calc(100vw - 28px); display:none; }\n  #info-card.show{ display:block; }\n  .ic-head{ display:flex; align-items:center; gap:9px; }\n  .ic-idx{ font-size:11px; color:var(--accent); border:1px solid rgba(79,194,232,.5); border-radius:6px; padding:2px 6px; }\n  .ic-head h3{ font-size:16px; flex:1; }\n  .ic-close{ background:none; border:0; color:var(--text-dim); font-size:15px; cursor:pointer; padding:4px 6px; }\n  .ic-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }\n  .chip{ font-size:10.5px; padding:2.5px 8px; border-radius:20px; border:1px solid var(--panel-border); color:var(--text-dim); }\n  .chip.u{ color:#7fe3c0; border-color:rgba(127,227,192,.35); }\n  .chip.e{ color:#ffc44d; border-color:rgba(255,196,77,.35); }\n  .chip.t{ color:#a8c8ff; border-color:rgba(168,200,255,.35); }\n  .ic-depth{ margin-top:10px; font-size:11.5px; color:var(--text-dim); }\n  .ic-depth b{ font-size:19px; color:var(--text); margin:0 2px; font-variant-numeric:tabular-nums; }\n  .ic-bar{ height:5px; border-radius:3px; background:rgba(255,255,255,.08); margin-top:6px; overflow:hidden; }\n  .ic-bar i{ display:block; height:100%; border-radius:3px; }\n  .ic-note{ margin-top:8px; font-size:11px; color:var(--text-dim); line-height:1.55; }\n\n  /* ---------- 提示/注释 ---------- */\n  #hint{\n    position:fixed; z-index:9; left:50%; bottom:16px; transform:translateX(-50%);\n    font-size:11.5px; color:var(--text-dim);\n    background:rgba(var(--panel-rgb), .6); border:1px solid var(--panel-border); border-radius:20px;\n    padding:6px 16px; white-space:nowrap; pointer-events:none;\n    transition:opacity 1s; backdrop-filter:blur(8px);\n  }\n  #note{ position:fixed; z-index:9; right:14px; bottom:14px; font-size:10px; color:var(--text-dim); text-align:right; line-height:1.5; pointer-events:none; max-width:46vw; }\n\n  /* ---------- 加载/错误 ---------- */\n  #loading{\n    position:fixed; inset:0; z-index:50; display:flex; flex-direction:column; gap:16px;\n    align-items:center; justify-content:center; background:#050a13;\n    transition:opacity .6s; font-size:13px; color:var(--text-dim);\n  }\n  #loading.hide{ opacity:0; pointer-events:none; }\n  .spinner{ width:34px; height:34px; border-radius:50%; border:3px solid rgba(79,194,232,.18); border-top-color:var(--accent); animation:spin 1s linear infinite; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  #load-error{ display:none; text-align:center; line-height:1.8; padding:0 20px; }\n  #load-error a{ color:var(--accent); }\n\n  /* ---------- 移动端 ---------- */\n  #btn-list-toggle{ display:none; }\n  @media (max-width: 860px){\n    #panel-title{ width:calc(100vw - 28px); }\n    #panel-ctrl{ top:auto; bottom:64px; right:14px; width:210px; display:none; }\n    #panel-ctrl.show{ display:block; }\n    #panel-list{\n      top:auto; bottom:0; left:0; right:0; width:auto;\n      max-height:46vh; border-radius:16px 16px 0 0;\n      display:none; padding-bottom:max(14px, env(safe-area-inset-bottom));\n    }\n    #panel-list.show{ display:flex; }\n    #st-list{ max-height:calc(46vh - 60px); }\n    #info-card{ bottom:56px; }\n    #note{ display:none; }\n    #hint{ display:none; }\n    #btn-list-toggle{\n      display:block; position:fixed; z-index:11; right:14px; bottom:14px;\n      background:rgba(var(--panel-rgb), .85); color:var(--accent);\n      border:1px solid rgba(79,194,232,.45); border-radius:22px;\n      padding:9px 16px; font-size:12.5px; cursor:pointer; backdrop-filter:blur(8px);\n    }\n    #btn-ctrl-toggle{\n      display:block !important; position:fixed; z-index:11; right:14px; bottom:60px;\n      background:rgba(var(--panel-rgb), .85); color:var(--text);\n      border:1px solid var(--panel-border); border-radius:22px;\n      padding:9px 14px; font-size:12.5px; cursor:pointer; backdrop-filter:blur(8px);\n    }\n  }\n  #btn-ctrl-toggle{ display:none; }\n\n  /* ---------- 多线路图例 ---------- */\n  .lg-grid{ display:flex; flex-wrap:wrap; gap:5px; margin-top:6px; }\n  .lg-chip-btn{\n    display:flex; align-items:center; gap:5px; background:rgba(var(--input-rgb), .6);\n    border:1px solid var(--panel-border); border-radius:12px; padding:3px 8px;\n    color:var(--text-dim); font-size:10.5px; cursor:pointer; transition:all .15s;\n  }\n  .lg-chip-btn:hover{ color:var(--text); border-color:rgba(var(--border-rgb), .5); }\n  .lg-chip-btn i{ width:12px; height:5px; border-radius:3px; }\n  .lg-chip-btn.active{ background:rgba(79,194,232,.18); color:var(--accent); border-color:rgba(79,194,232,.55); }\n\n  /* ---------- 站点列表分组 ---------- */\n  .grp-head{\n    display:flex; align-items:center; gap:8px; width:100%; margin-top:4px;\n    background:rgba(var(--input-rgb), .45); border:0; border-radius:8px; padding:7px 8px;\n    color:var(--text); font-size:12px; cursor:pointer; font-family:inherit; text-align:left;\n  }\n  .grp-head:hover{ background:rgba(79,194,232,.12); }\n  .grp-head i{ width:14px; height:6px; border-radius:3px; flex:none; }\n  .grp-head b{ color:var(--text-dim); font-weight:400; font-size:10.5px; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .grp-head::after{ content:'▶'; margin-left:auto; font-size:9px; color:var(--text-dim); transition:transform .2s; }\n  .grp-head.open::after{ transform:rotate(90deg); }\n  .grp-body{ padding-left:6px; }\n\n  /* ---------- 多线路图例 ---------- */\n  .lg-grid{ display:flex; flex-wrap:wrap; gap:5px; margin-top:6px; }\n  .lg-chip-btn{\n    display:flex; align-items:center; gap:5px; background:rgba(var(--input-rgb), .6);\n    border:1px solid var(--panel-border); border-radius:12px; padding:3px 8px;\n    color:var(--text-dim); font-size:10.5px; cursor:pointer; transition:all .15s;\n  }\n  .lg-chip-btn:hover{ color:var(--text); border-color:rgba(var(--border-rgb), .5); }\n  .lg-chip-btn i{ width:12px; height:5px; border-radius:3px; }\n  .lg-chip-btn.active{ background:rgba(79,194,232,.18); color:var(--accent); border-color:rgba(79,194,232,.55); }\n\n  /* ---------- 站点列表分组 ---------- */\n  .grp-head{\n    display:flex; align-items:center; gap:8px; width:100%; margin-top:4px;\n    background:rgba(var(--input-rgb), .45); border:0; border-radius:8px; padding:7px 8px;\n    color:var(--text); font-size:12px; cursor:pointer; font-family:inherit; text-align:left;\n  }\n  .grp-head:hover{ background:rgba(79,194,232,.12); }\n  .grp-head i{ width:14px; height:6px; border-radius:3px; flex:none; }\n  .grp-head b{ color:var(--text-dim); font-weight:400; font-size:10.5px; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .grp-head::after{ content:'▶'; margin-left:auto; font-size:9px; color:var(--text-dim); transition:transform .2s; }\n  .grp-head.open::after{ transform:rotate(90deg); }\n  .grp-body{ padding-left:6px; }\n\n  /* ---------- 站点面板：可折叠 ---------- */\n  #panel-list.collapsed{ display:none !important; }\n  #panel-list h2{ display:flex; align-items:center; gap:6px; }\n  #btn-list-collapse{\n    margin-left:auto; background:none; border:0; color:var(--text-dim);\n    cursor:pointer; font-size:15px; line-height:1; padding:2px 7px; border-radius:6px;\n    transition:all .15s;\n  }\n  #btn-list-collapse:hover{ background:rgba(79,194,232,.14); color:var(--text); }\n  #btn-list-float{\n    display:none; position:fixed; z-index:11; right:14px; top:50%;\n    transform:translateY(-50%);\n    flex-direction:column; align-items:center; gap:5px;\n    width:44px; padding:11px 0; border-radius:14px;\n    background:var(--panel-bg); border:1px solid var(--panel-border);\n    backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);\n    color:var(--text-dim); font-size:10px; cursor:pointer;\n    box-shadow:0 6px 24px rgba(0,0,0,.4); transition:all .18s;\n  }\n  #btn-list-float:hover{ color:var(--text); border-color:rgba(var(--border-rgb), .5); }\n  #btn-list-float .ic{ font-size:15px; line-height:1; color:var(--accent); }\n  #btn-list-float b{ font-weight:600; color:var(--text); font-variant-numeric:tabular-nums; }\n  @media (max-width: 860px){\n    #btn-list-float{ display:none !important; }\n    #btn-list-collapse{ display:none; }\n  }\n\n  /* ---------- 分享按钮 / 折叠按钮 ---------- */\n  #panel-title h1{ position:relative; }\n  .h1-tools{ margin-left:auto; display:flex; gap:4px; }\n  .h1-btn{\n    background:rgba(var(--input-rgb), .7); border:1px solid var(--panel-border); color:var(--text-dim);\n    border-radius:7px; width:26px; height:24px; font-size:12px; cursor:pointer; line-height:1;\n    display:flex; align-items:center; justify-content:center; transition:all .15s; padding:0;\n  }\n  .h1-btn:hover{ color:var(--accent); border-color:rgba(79,194,232,.55); }\n  #btn-title-toggle{ display:none; }\n\n  /* ---------- 分享面板 ---------- */\n  #share-panel{\n    display:none; position:fixed; z-index:30; right:14px; top:14px; width:300px;\n    max-width:calc(100vw - 28px);\n  }\n  #share-panel.show{ display:block; }\n  .sh-head{ display:flex; align-items:center; margin-bottom:10px; }\n  .sh-head b{ font-size:13px; flex:1; }\n  .sh-head button{ background:none; border:0; color:var(--text-dim); font-size:14px; cursor:pointer; padding:2px 6px; }\n  .sh-link{ display:flex; gap:6px; }\n  .sh-link input{\n    flex:1; min-width:0; background:rgba(12,26,44,.9); border:1px solid var(--panel-border);\n    border-radius:7px; color:var(--text); font-size:11px; padding:6px 8px; outline:none;\n  }\n  .sh-link button{\n    background:rgba(79,194,232,.16); border:1px solid rgba(79,194,232,.5); color:var(--accent);\n    border-radius:7px; font-size:11px; padding:0 10px; cursor:pointer; white-space:nowrap;\n  }\n  .sh-qr{ margin-top:10px; text-align:center; }\n  .sh-qr img{ width:150px; height:150px; border-radius:10px; background:#0a1626; border:1px solid var(--panel-border); }\n  .sh-btns{ display:flex; gap:6px; margin-top:10px; }\n  .sh-btns button{\n    flex:1; background:rgba(var(--input-rgb), .75); border:1px solid var(--panel-border); border-radius:7px;\n    color:var(--text); font-size:11px; padding:7px 2px; cursor:pointer; transition:all .15s;\n  }\n  .sh-btns button:hover{ border-color:rgba(79,194,232,.55); color:var(--accent); }\n  .sh-tip{ margin-top:8px; font-size:10.5px; color:var(--text-dim); line-height:1.55; min-height:14px; }\n\n  /* ---------- 移动端：顶部面板折叠 ---------- */\n  @media (max-width: 860px){\n    #panel-title{ padding:8px 10px; transition:max-height .25s ease; }\n    #panel-title h1{ font-size:13px; gap:6px; }\n    #panel-title h1 .dot{ width:8px; height:8px; }\n    #panel-title .sel-row{ margin-top:7px; }\n    #panel-title.collapsed #stat-line,\n    #panel-title.collapsed #legend{ display:none; }\n    #btn-title-toggle{ display:flex; }\n    #share-panel{ left:14px; right:14px; top:auto; bottom:76px; width:auto; }\n  }\n\n  /* ---------- 站点搜索 ---------- */\n  .search-row{ margin-top:8px; position:relative; }\n  .search-row input{\n    width:100%; background:rgba(var(--input-rgb), .9); color:var(--text);\n    border:1px solid var(--panel-border); border-radius:8px; padding:6px 9px; font-size:12px; outline:none;\n  }\n  .search-row input:focus{ border-color:var(--accent); }\n  .search-row input::placeholder{ color:var(--text-dim); }\n  #search-drop{\n    position:absolute; top:100%; left:0; right:0; margin-top:4px; z-index:60;\n    background:rgba(var(--drop-rgb), .97); border:1px solid var(--panel-border); border-radius:10px;\n    max-height:260px; overflow:auto; display:none;\n  }\n  #search-drop .sr{\n    display:flex; align-items:center; gap:7px; padding:6px 9px; cursor:pointer; font-size:12px;\n    border-bottom:1px solid rgba(var(--border-rgb), .08);\n  }\n  #search-drop .sr:last-child{ border-bottom:none; }\n  #search-drop .sr:hover, #search-drop .sr.act{ background:rgba(79,194,232,.16); }\n  #search-drop .sr i{ width:8px; height:8px; border-radius:2px; flex:none; }\n  #search-drop .sr b{ flex:none; font-weight:600; }\n  #search-drop .sr span{ color:var(--text-dim); font-size:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  #search-drop .sr .ct{ margin-left:auto; flex:none; color:var(--text-dim); font-size:10.5px; }\n  #search-drop .empty{ padding:8px 10px; font-size:11.5px; color:var(--text-dim); }\n\n  /* ---------- 纵断面面板 ---------- */\n  #profile-panel{\n    left:50%; bottom:52px; transform:translateX(-50%);\n    width:min(760px, calc(100vw - 300px)); display:none; padding:9px 12px 10px;\n  }\n  #profile-panel.show{ display:block; }\n  #profile-panel .pf-head{ display:flex; align-items:center; gap:8px; margin-bottom:5px; }\n  #profile-panel .pf-head b{ font-size:12px; }\n  #profile-panel .pf-head .pf-sub{ font-size:10.5px; color:var(--text-dim); flex:1; }\n  #profile-panel .pf-close{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:13px; padding:0 2px; }\n  #profile-panel .pf-close.on{ color:var(--accent); }\n  #profile-canvas{ display:block; width:100%; cursor:crosshair; }\n  @media (max-width: 860px){\n    #profile-panel{ width:calc(100vw - 28px); bottom:46px; }\n  }\n\n  /* ---------- 城市对比面板 ---------- */\n  #cmp-panel{\n    top:14px; right:264px; width:320px; display:none; padding:11px 13px; max-height:calc(100vh - 28px); overflow:auto;\n  }\n  #cmp-panel.show{ display:block; }\n  #cmp-panel h2{ font-size:12.5px; color:var(--text-dim); font-weight:600; letter-spacing:1px; margin-bottom:8px; display:flex; justify-content:space-between; }\n  #cmp-panel h2 button{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:13px; }\n  #cmp-panel .cmp-sel{ display:flex; gap:6px; margin-bottom:8px; }\n  #cmp-panel .cmp-sel select{\n    flex:1; min-width:0; background:rgba(var(--input-rgb), .9); color:var(--text);\n    border:1px solid var(--panel-border); border-radius:8px; padding:5px 6px; font-size:12px; outline:none;\n  }\n  #cmp-canvas{ display:block; width:100%; }\n  @media (max-width: 860px){\n    #cmp-panel{ right:14px; width:calc(100vw - 28px); top:56px; }\n  }\n\n  /* ---------- 罗盘 ---------- */\n  #compass{\n    position:fixed; z-index:12; right:262px; top:14px;\n    width:54px; height:54px; border-radius:50%;\n    background:rgba(var(--panel-rgb), .72); border:1px solid var(--panel-border);\n    cursor:pointer; user-select:none;\n    box-shadow:0 2px 12px rgba(0,0,0,.35);\n  }\n  #compass-rose{\n    position:absolute; inset:0;\n    transition:none; will-change:transform;\n  }\n  #compass-rose .dir{\n    position:absolute; left:50%; top:50%; font-size:9.5px; line-height:1;\n    font-weight:600; color:var(--text-dim);\n  }\n  #compass-rose .dir.n{ color:#ff6a5e; }\n  #compass-needle{\n    position:absolute; left:50%; top:50%; width:0; height:0;\n    border-left:3.5px solid transparent; border-right:3.5px solid transparent;\n    border-bottom:15px solid #ff6a5e;\n    transform:translate(-50%,-100%);\n  }\n  #compass .deg{\n    position:absolute; left:50%; bottom:3px; transform:translateX(-50%);\n    font-size:8px; color:var(--text-dim); white-space:nowrap;\n  }\n  /* 罗盘移动端重定位（v1.7.0）：窄屏压住标题 → 移到左下角缩小。\n     必须位于基础规则之后（同优先级靠后生效）。 */\n  @media (max-width: 860px){\n    #compass{\n      right:auto; top:auto; left:14px; bottom:14px;\n      width:46px; height:46px;\n    }\n  }\n\n  /* ---------- 车次信息卡 ---------- */\n  #train-card{\n    right:14px; bottom:52px; width:268px; max-width:calc(100vw - 28px); display:none;\n  }\n  #train-card.show{ display:block; }\n  #train-card .tc-head{ display:flex; align-items:center; gap:8px; }\n  #train-card .tc-badge{ font-size:10.5px; padding:2px 7px; border-radius:6px; border:1px solid var(--panel-border); color:var(--accent); }\n  #train-card .tc-row{ display:flex; justify-content:space-between; font-size:11.5px; color:var(--text-dim); margin-top:6px; }\n  #train-card .tc-row b{ color:var(--text); font-weight:600; }\n  #train-card .tc-close{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:13px; margin-left:auto; }\n  #train-card .tc-bar{ height:4px; border-radius:2px; background:rgba(var(--border-rgb), .2); margin-top:9px; overflow:hidden; }\n  #train-card .tc-bar i{ display:block; height:100%; border-radius:2px; }\n  /* ---------- 标注编辑器 ---------- */\n  #anno-card{\n    left:50%; bottom:100px; transform:translateX(-50%);\n    width:min(340px, calc(100vw - 40px)); display:none; padding:12px 14px;\n  }\n  #anno-card.show{ display:block; }\n  #anno-card .ac-head{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }\n  #anno-card .ac-head b{ font-size:12.5px; }\n  #anno-card .ac-head .ac-mode{ font-size:10.5px; color:var(--accent); }\n  #anno-card .ac-head button{ margin-left:auto; background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:13px; }\n  #anno-card input[type=text]{\n    width:100%; background:rgba(var(--input-rgb), .9); color:var(--text);\n    border:1px solid var(--panel-border); border-radius:8px; padding:6px 9px; font-size:12px; outline:none;\n  }\n  #anno-card .ac-row{ display:flex; gap:6px; margin-top:8px; }\n  #anno-card .ac-row .btn{ flex:1; }\n  #anno-card #anno-list{ margin-top:8px; max-height:150px; overflow:auto; }\n  #anno-card .ai-row{\n    display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--text);\n    padding:4px 2px; border-bottom:1px solid rgba(var(--border-rgb), .08);\n  }\n  #anno-card .ai-row b{ cursor:pointer; }\n  #anno-card .ai-row button{ margin-left:auto; background:none; border:none; color:var(--text-dim); cursor:pointer; }\n  /* ---------- 首次访问引导 ---------- */\n  #tour-mask{\n    position:fixed; inset:0; z-index:80; background:rgba(2,6,12,.55);\n    display:none;\n  }\n  #tour-mask.show{ display:block; }\n  #tour-card{\n    position:fixed; z-index:81; left:50%; top:50%; transform:translate(-50%,-50%);\n    width:min(420px, calc(100vw - 40px)); padding:20px 22px; display:none;\n  }\n  #tour-card.show{ display:block; }\n  #tour-card h3{ font-size:14.5px; color:var(--text); margin-bottom:12px; }\n  #tour-card .tr{ display:flex; gap:10px; align-items:flex-start; margin-bottom:10px; }\n  #tour-card .tr i{\n    flex:none; width:22px; height:22px; border-radius:6px; background:rgba(var(--border-rgb),.18);\n    color:var(--accent); font-style:normal; font-weight:700; font-size:12px;\n    display:flex; align-items:center; justify-content:center;\n  }\n  #tour-card .tr b{ display:block; font-size:12.5px; color:var(--text); }\n  #tour-card .tr span{ font-size:11px; color:var(--text-dim); line-height:1.5; }\n  #tour-card .tour-btn{\n    margin-top:6px; width:100%; padding:9px; border-radius:8px; border:1px solid rgba(79,194,232,.55);\n    background:rgba(79,194,232,.16); color:var(--accent); font-size:13px; cursor:pointer;\n  }\n  /* ---------- 图层面板 ---------- */\n  #layer-panel{\n    top:270px; right:14px; width:176px; display:none; padding:10px 12px;\n  }\n  #layer-panel.show{ display:block; }\n  #layer-panel .lp-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }\n  #layer-panel .lp-head b{ font-size:12px; }\n  #layer-panel .lp-head button{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:12px; }\n  #layer-panel .lp-row{\n    display:flex; align-items:center; gap:7px; font-size:11.5px; color:var(--text);\n    padding:4px 2px; cursor:pointer; user-select:none;\n  }\n  #layer-panel .lp-row input{ accent-color: var(--accent); }\n  /* ---------- 提示条 ---------- */\n  .perf-toast{\n    position:fixed; left:50%; bottom:64px; transform:translateX(-50%); z-index:90;\n    background:var(--toast-bg); border:1px solid rgba(var(--border-rgb), .25);\n    border-radius:10px; padding:8px 14px; font-size:12px; color:var(--text);\n    opacity:0; transition:opacity .4s; pointer-events:none;\n  }\n  /* ---------- 墓葬详情卡 ---------- */\n  #tomb-card{\n    right:14px; bottom:52px; width:320px; max-width:calc(100vw - 28px); display:none;\n    max-height:calc(100vh - 120px); overflow:auto;\n  }\n  #tomb-card.show{ display:block; }\n  #tomb-canvas{ display:block; width:100%; border-radius:8px; margin:7px 0; }\n  #tomb-card .tc-intro{ font-size:11.5px; line-height:1.75; color:var(--text); }\n  #tomb-card .tc-note{ font-size:9.5px; color:var(--text-dim); margin-top:6px; }\n  #tomb-card .tc-close{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:13px; }\n\n  /* ⚠️ 协同规则（v1.8.1，勿移除）：隐藏门户注入的 4 个 FAB——\n     本应用自带完整主题/分享/导航控件，门户 FAB 在窄屏与\n     「⚙ 视图 / 站点」浮钮四重重叠（真实缺陷，截图存证），桌面端亦冗余。\n     补丁层用 display:inline-flex!important 且注入在文档末尾，\n     故此处用更高优先级选择器（html body 前缀）对抗。 */\n  html body #v2-style-fab, html body #v2-theme-fab,\n  html body #v2-home-fab, html body #v2-share-fab { display:none !important; }\n  /* 补丁层引用但本页未定义的变量（有 var() 回退，定义以消除 CI 警告） */\n  :root{ --bg-2:#0d1520; --font:inherit; }\n\n  /* —— 深度之最（v1.9.1）：全国深埋站排行榜（实时计算自 8180 站数据）—— */\n  #deeptop-panel{ top:14px; right:264px; width:300px; display:none; padding:11px 13px;\n    max-height:calc(100vh - 28px); overflow:auto; }\n  #deeptop-panel.show{ display:block; }\n  #deeptop-panel .dt-row{ display:flex; align-items:center; gap:9px; padding:7px 8px;\n    border-radius:9px; cursor:pointer; }\n  #deeptop-panel .dt-row:hover, #deeptop-panel .dt-row:focus-visible{ background:rgba(79,194,232,.12); outline:none; }\n  #deeptop-panel .dt-rank{ width:26px; text-align:center; font-weight:700; font-size:12px;\n    color:var(--text-dim); flex:none; }\n  #deeptop-panel .dt-rank.top{ color:var(--accent); }\n  #deeptop-panel .dt-main{ flex:1; min-width:0; }\n  #deeptop-panel .dt-name{ font-size:12.5px; font-weight:600; color:var(--text);\n    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  #deeptop-panel .dt-name .dt-src{ color:#30d158; }\n  #deeptop-panel .dt-city{ font-size:10.5px; color:var(--text-dim); margin-top:1px; }\n  #deeptop-panel .dt-bar{ height:3px; border-radius:2px; background:rgba(var(--border-rgb), .25);\n    margin-top:4px; overflow:hidden; }\n  #deeptop-panel .dt-bar i{ display:block; height:100%; background:rgba(79,194,232,.6); }\n  #deeptop-panel .dt-depth{ flex:none; font-weight:700; color:var(--accent); font-size:12px; }\n  #deeptop-panel .dt-note{ font-size:10.5px; color:var(--text-dim); margin:10px 2px 2px; line-height:1.6; }\n  @media (max-width: 860px){\n    #deeptop-panel{ top:auto; bottom:0; left:0; right:0; width:auto; max-height:52vh;\n      border-radius:16px 16px 0 0; padding-bottom:max(14px, env(safe-area-inset-bottom)); }\n    #deeptop-panel .pf-sub{ display:none; }\n  }\n\n  /* ===== v2.2.0 无障碍补强（审计 P1-3/P1-9）===== */\n  /* 键盘焦点环：原先多处 outline:none 无替代（WCAG 2.4.7） */\n  :where(button, a, input, select, textarea, [tabindex]):focus-visible{\n    outline:2px solid var(--accent); outline-offset:2px; border-radius:6px;\n  }\n  /* 浅色主题下 .dt-src（#30d158 在浅底仅 1.97:1）与来源 chip 加深 */\n  html[data-theme=\"light\"] .dt-src{ color:#0a7a3d; }\n  html[data-theme=\"light\"] .chip.u{ color:#076b47; }\n  html[data-theme=\"light\"] .chip.e{ color:#7a4d00; }\n  /* 减少动态（系统偏好或 &rm=1）：CSS 层一并关闭过渡与旋转动画 */\n  html[data-reduce-motion=\"1\"] *, html[data-reduce-motion=\"1\"] *::before, html[data-reduce-motion=\"1\"] *::after{\n    animation-duration:.001ms !important; animation-iteration-count:1 !important;\n    transition-duration:.001ms !important; scroll-behavior:auto !important;\n  }\n\n  /* 屏幕阅读器专用（视觉隐藏但可朗读）——v2.2.0 */\n  .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n\n  /* —— 星图生长史时间轴（v2.1.0）—— */\n  #nation-time{ display:none; position:fixed; left:50%; transform:translateX(-50%);\n    bottom:14px; z-index:30; width:min(620px, calc(100vw - 28px));\n    background:rgba(var(--panel-rgb), .9); border:1px solid var(--panel-border);\n    border-radius:14px; padding:10px 14px 11px; backdrop-filter:blur(12px);\n    box-shadow:0 8px 28px rgba(0,0,0,.35); }\n  #nation-time.show{ display:block; }\n  #nation-time .nt-head{ display:flex; align-items:center; gap:9px; font-size:11.5px; color:var(--text-dim); }\n  #nation-time .nt-year{ font-size:17px; font-weight:800; color:var(--accent); font-variant-numeric:tabular-nums; }\n  #nation-time .nt-stat{ flex:1; font-variant-numeric:tabular-nums; }\n  #nation-time .nt-btn{ background:none; border:1px solid var(--panel-border); color:var(--text);\n    border-radius:999px; font-size:11px; padding:4px 11px; cursor:pointer; min-height:26px; }\n  #nation-time .nt-btn.on{ color:var(--accent); border-color:var(--accent); }\n  #nation-time input[type=range]{ width:100%; margin-top:7px; accent-color:#4FC2E8; }\n  @media (max-width: 860px){\n    #nation-time{ bottom:calc(14px + env(safe-area-inset-bottom)); padding:8px 12px 9px; }\n    #nation-time .nt-year{ font-size:15px; }\n    #nation-time .nt-stat{ font-size:10.5px; }\n  }\n"],"\n\n","\n",["STYLE",{},"\n/* 🔴 2026-10-19：隐藏页面自带旧主题按钮 #themeToggle —— 它与注入 FAB(v2-theme-fab)\n   形成双按钮并存，且其脚本写旧键 aihot_theme_v1，与 v3 失同步。FAB 是三态唯一入口。 */\n#themeToggle{display:none!important}\n/* 🔴 2026-10-20 任务B/C：小文字抬升（11px → 12px，WCAG AA 建议值，全站 390 页）\n   构成（39 页样本 55 处）：daily 页 .pill 来源胶囊 38 / mp 页正文 .tag 小标签 16 / bookmarks .foot 1\n   页面自带 <style> 里 .pill/.tag 为 11px，注入层 !important 统一覆盖。 */\n.pill,.tag,.foot{font-size:12px!important}\n/* 🔴 2026-10-20 任务B/C：小点击区热区补齐（44×44，密集 chips 40px 折中，全站 245 页）\n   构成（39 页样本 157 处）：\n   ① .top a   section/topic/mp 页顶导 24px → 44px（竖排 3 个，非密集）\n   ② .nav a   section 页主题 chips 29px → 40px（横排 12 个密集 → 折中）\n   ③ .list li a  topic 页全量列表：li padding 清零改由 A padding 撑，\n      A 热区 25px → 45px，文字垂直位置不变（原 li padding 10px = 新 A padding 10px）\n   ④ .thread li a  topic 页主线阅读 inline 21px → padding 热区 45px（inline padding 不占布局）\n   ⑤ .v2-related li a  日报/周报/deep 同主题推荐 26px → 44px（同 ③ 手法） */\n.top a{min-height:44px;display:inline-flex;align-items:center}\n.nav a{min-height:40px;display:flex;align-items:center}\n.list li{padding-top:0!important;padding-bottom:0!important}\n.list li a{padding-top:10px;padding-bottom:10px}\n.thread li a{padding-top:12px;padding-bottom:12px}\n.v2-related li{padding-top:0!important;padding-bottom:0!important}\n.v2-related li a{padding-top:11px;padding-bottom:11px}\n/* 2026-10-20 任务B/C 二轮：老文章页与报告页内联 11px 小字（栏目标签/时间戳/点赞在看转发/序号/表格小字）\n   全站 #334 方针「字号 ≥12px」收尾；属性选择器 + !important 覆盖元素内联 style。\n   实测：1237 页均有注入，仅影响带该内联的元素（无内联者不命中）。 */\n[style*=\"font-size:11px\"],[style*=\"font-size: 11px\"]{font-size:12px!important}\n/* 2026-10-20 任务B/C 终极兜底：code/kbd/samp/.tagx 一律 12px!important\n   原因：各页 code 规则用 .75~.86em/.rem 相对单位，在 12.5-16px 父级下\n   算出 10.3-13.8px 不等，逐页 patch 整不干净；注入层一条统一（重注入不丢）。\n   特异性：(0,1,0)+!important 覆盖页面 .xx code(0,1,1) 与无特异性内联。 */\ncode,kbd,samp,.tagx{font-size:12px!important}\n/* 2026-10-20 任务B/C 热区兜底（从页级 patch 固化为注入层，重注入必带、永不失丢）\n   静态老报告页目录导航与复制按钮实测 24-37px。选择器均为结构特定类\n   （仅老报告页出现），!important 覆盖页面自有规则。 */\n.side nav a,.toc a,.mnav a,.sidebar nav a,.sidebar li.sub a.sub,.stat .s{min-height:45px!important;display:flex!important;align-items:center!important}\n.cb-copy{min-height:45px!important;display:inline-flex!important;align-items:center!important;padding:0 14px!important}\n/* 2026-10-20 深色表格兜底：上游同步页（含 01-13 老页）的斑马纹\n   tr:nth-child td{background:#f6f6f6} 在深色下呈白底；DARKFIX 的 JS rgb 解析\n   对部分页未命中，故在注入层用 CSS 统一兜底（仅 dark）。 */\nhtml[data-theme=\"dark\"] table td,html[data-theme=\"dark\"] table th{\n  background-color:#171c22!important;color:#e8ecf1!important;border-bottom-color:#2a3038!important}\n/* weekly 统计条目补充说明 .stat .s（实测 11.5px，仅 weekly/bookmarks/hodl-or-fold 等少数页有 .stat 容器） */\n.stat .s{font-size:12px!important}\n/* 老页 v2-related 短标题链接行高 21px + padding 22 = 43px，差 1px → min-height 兜底 */\n.v2-related li a{min-height:44px;display:flex;align-items:center}\n/* 中性刊物色板 · 深（默认） */\n:root{--bg:#101418;--bg2:#15191f;--bg3:#1a2027;--card:#171c22;--card-2:#1c222a;\n--border:rgba(255,255,255,.09);--border-strong:rgba(255,255,255,.16);\n--text:#e8ecf1;--text2:#98a3b1;--text3:#6f7a88;\n--accent:#4f8cff;--primary:#4f8cff;--primary2:#8b5cf6;--primary-dark:#2563eb;\n--chip-bg:rgba(255,255,255,.06);--chip-ink:#98a3b1;--pill-bg:rgba(255,255,255,.05);--pill-ink:#98a3b1;\n--code-bg:#1a2027;--code-text:#e8ecf1;\n--danger:#f26d6d;--success:#34d399;--info:#22d3ee;\n--gradient1:#3b82f6;--gradient2:#8b5cf6;--gradient3:#22d3ee;\n--shadow:0 8px 24px rgba(0,0,0,.35)}\n/* 浅 */\nhtml[data-theme=\"light\"]{--bg:#f7f8fa;--bg2:#eef0f3;--bg3:#e6e9ee;--card:#ffffff;--card-2:#fbfcfe;\n--border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.15);\n--text:#14181d;--text2:#5b6472;--text3:#8a929c;\n--accent:#1d4ed8;--primary:#1d4ed8;--primary2:#8b5cf6;--primary-dark:#1d4ed8;\n--chip-bg:rgba(0,0,0,.05);--chip-ink:#5b6472;--pill-bg:rgba(0,0,0,.04);--pill-ink:#5b6472;\n--code-bg:#f1f3f6;--code-text:#14181d;\n--danger:#d23f3f;--success:#0b7a54;--info:#0c7d8a;\n--gradient1:#3b82f6;--gradient2:#8b5cf6;--gradient3:#0ea5b7;\n--shadow:0 8px 24px rgba(0,0,0,.06)}\n/* B 类硬编码页兜底（仅颜色，不动布局） */\nhtml[data-theme] body{background:var(--bg);color:var(--text)}\nhtml[data-theme] h1,html[data-theme] h2,html[data-theme] h3,html[data-theme] h4{color:var(--text)}\nhtml[data-theme] a{color:var(--accent)}\nhtml[data-theme] .card,html[data-theme] .card-body{background:var(--card);border-color:var(--border)}\nhtml[data-theme] code,html[data-theme] pre{background:var(--code-bg);color:var(--code-text)}\nhtml[data-theme] blockquote{background:var(--bg2);border-left-color:var(--accent)}\n/* 悬浮切换钮 */\n#v2-theme-fab{position:fixed;right:calc(env(safe-area-inset-right) + 16px);bottom:calc(env(safe-area-inset-bottom) + 16px);\nwidth:44px;height:44px;border-radius:50%;border:1px solid var(--border-strong);cursor:pointer;z-index:9999;\nbackground:color-mix(in srgb,var(--card) 88%,transparent);color:var(--text);font-size:18px;line-height:1;\nbox-shadow:var(--shadow);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}\n#v2-theme-fab:hover{transform:translateY(-2px)}\n/* 返回首页浮钮（优化项3：子页返回入口） */\n#v2-home-fab{position:fixed;right:calc(env(safe-area-inset-right) + 68px);bottom:calc(env(safe-area-inset-bottom) + 16px);\nwidth:44px;height:44px;border-radius:50%;border:1px solid var(--border-strong);z-index:9999;display:flex;\nalign-items:center;justify-content:center;text-decoration:none;font-size:17px;color:var(--text);\nbackground:color-mix(in srgb,var(--card) 88%,transparent);box-shadow:var(--shadow);\n-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}\n#v2-home-fab:hover{transform:translateY(-2px)}\n/* === 返回入口可发现性修复（2026-10-09）===\n   根因：返回浮钮原本是纯符号 ⌂，且与主题按钮并排在右下角，用户找不到。\n   修复：① 浮钮改为「← 返回」胶囊（文字+符号），触摸目标≥44px；\n        ② ≥720px 视口隐藏浮钮，改用顶部固定返回栏（长文页最熟悉的位置）。 */\n#v2-home-fab{gap:5px;padding:0 14px;width:auto;min-width:44px;\nfont-family:var(--font,inherit)}\n.v2-fab-ico{font-size:17px;line-height:1}\n.v2-fab-txt{font-size:13px;font-weight:600;line-height:1}\n@media (max-width:719px){.v2-fab-txt{display:none}\n#v2-home-fab{width:44px;padding:0;justify-content:center}}\n/* 顶部返回栏 */\n.v2-topbar{position:fixed;top:0;left:0;right:0;z-index:9998;display:none;\nalign-items:center;gap:10px;height:42px;padding:0 14px;\nbackground:color-mix(in srgb,var(--bg) 88%,transparent);\nborder-bottom:1px solid var(--border,rgba(128,128,128,.2));\n-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);\nfont-size:13px;box-sizing:border-box}\n.v2-topbar-back{display:inline-flex;align-items:center;gap:5px;\npadding:5px 10px;border-radius:8px;text-decoration:none;\ncolor:var(--text);font-weight:600;min-height:32px}\n.v2-topbar-back:hover{background:var(--card)}\n.v2-topbar-ico{font-size:16px;line-height:1}\n.v2-topbar-txt{white-space:nowrap}\n.v2-topbar-brand{margin-left:auto;color:var(--text3,var(--text));\nfont-size:12px;opacity:.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n/* ≥720px 显示顶部栏并隐藏右下角浮钮；<720px 反之（手机避免手势区冲突） */\n@media (min-width:720px){\n  /* 顶部返回栏已移除（2026-10-11），不再需要下移正文。\n     #v2-home-fab 现在桌面端也显示，位于右下角 style-fab 左侧。 */\n}\n@media (max-width:719px){.v2-topbar{display:none!important}}\n/*v2mobile-subpages*/\n/* ===== 移动端适配（iPhone 16 Pro Max 430x932）===== */\nhtml{-webkit-text-size-adjust:100%;text-size-adjust:100%}\nhtml,body{max-width:100%;overflow-x:clip}\nbody{-webkit-text-size-adjust:100%}\nimg,video,svg,canvas,iframe{max-width:100%!important;height:auto}\nimg[width]{width:100%!important}\n\n/* 顶部安全区（Pro Max 59px，非全屏为 0）+ 底部 Home Indicator 34px */\nbody{padding-top:env(safe-area-inset-top);\n  padding-bottom:calc(72px + env(safe-area-inset-bottom))}\n\n/* B7 修复（2026-10-18）：sticky 元素避让刘海（Pro Max Dynamic Island） */\n.v2-topbar,.sticky-nav,nav.sticky{top:env(safe-area-inset-top);\n  padding-top:env(safe-area-inset-top)}\n[id]{scroll-margin-top:calc(env(safe-area-inset-top) + 64px)}\n\n/* 677px 微信固定宽度 -> 响应式 */\nsection[max-width],section[style*=\"max-width:677px\"]{max-width:100%!important}\nsection[max-width=\"677px\"]{max-width:100%!important}\nsection[style*=\"677px\"]{max-width:100%!important}\n\n/* B5 修复（2026-10-18）：代码块允许横滚而非强制折行（pre-wrap 与 overflow-x 互斥二选一） */\npre{white-space:pre!important;overflow-x:auto!important;\n  -webkit-overflow-scrolling:touch;word-break:normal!important;\n  overflow-wrap:normal!important;max-width:100%!important}\ncode{overflow-wrap:anywhere}\n@media (max-width:719px){pre{font-size:12px}}\ntable{max-width:100%!important;width:100%!important;border-collapse:collapse}\n@media (max-width:719px){\n  table:not(.table-wrap table){display:table!important;width:100%!important;\n    max-width:100%!important;table-layout:fixed;overflow-x:visible!important}\n  table:not(.table-wrap table) th,\n  table:not(.table-wrap table) td{white-space:normal!important;\n    word-break:break-word;overflow-wrap:anywhere;vertical-align:top}\n}\n\n/* ===== B8 修复（2026-10-20）：移动端正文布局溢出 =====\n   成因：① 页面自带 grid-template-columns:1fr 在窄屏被内容撑开\n        （1fr 隐含 minmax(auto,1fr)，子项 min-content 撑破轨道）；\n        ② 页面自带 table{min-width:460px} 强制超出视图；\n        ③ 行内长串（URL / 标记）无断点。\n   后果：html,body{overflow-x:clip} 把超出部分裁掉，用户**无法滚动触达**（比横向滚动更严重）。\n   52 页审计中 overs 项 100% 由此产生。 */\n@media (max-width:719px){\n  .wrap,.layout,.container,.dev-grid,\n  [class$=\"-grid\"],[class^=\"grid-\"],[class*=\"-grid \"],\n  [style*=\"display:grid\"],[style*=\"display: grid\"]{\n    grid-template-columns:minmax(0,1fr)!important}\n  .wrap>*,.layout>*,.container>*,.dev-grid>*{min-width:0!important}\n}\n@media (max-width:719px){\n  table{min-width:0!important;table-layout:fixed!important;\n    width:100%!important;max-width:100%!important}\n  table th,table td{white-space:normal!important;\n    word-break:break-word!important;overflow-wrap:anywhere!important}\n}\n@media (max-width:719px){\n  code:not(pre code){white-space:normal!important;\n    overflow-wrap:anywhere!important;word-break:break-all!important}\n  label.txt,label.txt code,li>strong,span.tagx,\n  span.topo-bus-txt,span.tag.src,span.tag{\n    white-space:normal!important;overflow-wrap:anywhere!important;\n    word-break:break-word!important;max-width:100%!important}\n}\n\n/* ===== B9 修复（2026-10-20）：移动端触控热区 >= 44x44（WCAG 2.5.5）=====\n   实测 118 处不达标，集中在目录 / 案例卡 / 顶栏 / 返回栏 / 筛选控件。\n   注意：正文流内行内链接按既定铁律豁免（撑 44px 会破坏排版），此处只列真实控件。 */\n@media (max-width:719px){\n  .toc-inner a,.toc-item,.case-card a.case-link,.topbar-links a,\n  header nav a,.topbar nav a,.back-bar a,.site-bar a,.mnav a{\n    min-height:44px!important;min-width:44px!important;\n    display:flex!important;align-items:center!important;\n    justify-content:center!important;box-sizing:border-box!important}\n  select,input#searchInput,button#sortReset,#lb-view-btn{\n    min-height:44px!important;box-sizing:border-box!important}\n  .betctl button,#botInner button,.song-picker button,#song-picker button{\n    min-height:44px!important;min-width:44px!important;\n    box-sizing:border-box!important}\n  a.brand,header .brand,.topbar .brand{min-height:44px!important;box-sizing:border-box!important}\n  span.tag.src>a,span.tag>a,.tag a{\n    min-height:44px!important;min-width:44px!important;\n    display:inline-block!important;line-height:44px!important;\n    vertical-align:middle!important;box-sizing:border-box!important}\n}\n\n/* ===== B10 修复（2026-10-20）：字号下限 + 勾选框尺寸 =====\n   small（<12px）残留：td.dname>small、code>sub（真实问题）。\n   svg>text 图表标注随 viewBox 缩放，属审计判据外，不修。 */\n@media (max-width:719px){\n  td.dname small,code sub,small{font-size:12px!important}\n  .checklist li input[type=\"checkbox\"]{width:22px!important;height:22px!important}\n}\n\n/* ===== B11 修复（2026-10-20）：表单控件触控热区 =====\n   实测 input[type=search/number] 仅 33-36px 高、button 37px 高。\n   复选框/单选框豁免（热区由关联 label 提供）。 */\n@media (max-width:719px){\n  input:not([type=\"checkbox\"]):not([type=\"radio\"]):not([type=\"hidden\"]),\n  select,textarea{\n    min-height:44px!important;box-sizing:border-box!important}\n  button{min-height:44px!important;box-sizing:border-box!important}\n}\n\n/* ===== B12 修复（2026-10-20）：网格溢出运行时自愈 =====\n   问题：各页自建网格容器类名千变万化（.kpis/.columns/.facts/.dev-grid...），\n        静态选择器永远追不上 —— B8 覆盖到 .dev-grid，漏了 .kpis/.columns/.facts。\n        且 grid-template-columns:1fr 隐含 minmax(auto,1fr)，子项 min-content 会撑破轨道，\n        被 html,body{overflow-x:clip} 裁掉后用户无法触达（比横滚更严重）。\n   方案：改为运行时检测（GRIDFIX）—— 扫描所有 display:grid 容器，比较子项最小需求宽度\n        与容器可用宽度，超出的打 data-v2gf=\"1\"，由下方 CSS 强制单列。\n        **新增页面无需改 CSS**，一次修复覆盖全站与未来内容。\n   与既有「深色浅底兜底」同思路：静态规则 + JS computed 兜底。 */\n@media (max-width:719px){\n  [data-v2gf=\"1\"]{grid-template-columns:minmax(0,1fr)!important;\n    max-width:100%!important;overflow-x:visible!important}\n  [data-v2gf=\"1\"]>*{min-width:0!important;max-width:100%!important}\n}\n\n/* ===== B13 修复（2026-10-20）：无 JS 环境下的网格兜底（纯 CSS）=====\n   场景：mp-20260917-pc-healthcheck / mp-20261012-coremark-bench 两页自带\n         <meta http-equiv=\"Content-Security-Policy\" content=\"script-src 'none'\">\n         -> 注入层所有内联脚本（READ / DARKFIX / GRIDFIX）全部被 CSP 拦截，\n            GRIDFIX 运行时自愈在这两页永久失效。\n   定位：这是页面作者的有意安全设计（自包含离线报告页），不应篡改其 CSP。\n   方案：GRIDFIX 仍是全站主力（覆盖未知类名）；此处对这 2 页的已知网格类\n         补纯 CSS 单列规则，保证「无 JS」页面也有基本保障。\n   同时覆盖常见通用网格类名（.kpi-grid/.grid-2/.grid-3/.grid-4），\n   这些类名在多页复现，纯 CSS 兜底对它们同样有效且零风险。 */\n@media (max-width:719px){\n  /* coremark-bench：.kpis/.columns/.facts 网格 + 43px 大字号数字 */\n  .kpis,.columns,.facts,.verdict-grid,.actions{\n    grid-template-columns:minmax(0,1fr)!important}\n  .kpis>*,.columns>*,.facts>*,.verdict-grid>*,.actions>*{\n    min-width:0!important;max-width:100%!important}\n  .metric{font-size:32px!important;letter-spacing:-1px!important}\n  .metric em{font-size:13px!important;margin-left:4px!important}\n  .fact strong{font-size:17px!important}\n  /* pc-healthcheck：KPI / 栅格类 */\n  .kpi-grid,.grid-2,.grid-3,.grid-4{\n    grid-template-columns:minmax(0,1fr)!important}\n  .kpi-grid>*,.grid-2>*,.grid-3>*,.grid-4>*{\n    min-width:0!important;max-width:100%!important}\n  /* 长串断行兜底 */\n  .metric,.fact strong,.fact p,.kpis em{\n    overflow-wrap:anywhere!important;word-break:break-word!important}\n}\n\n/* ===== 深色模式：强制对齐主站（用户裁决）=====\n   子页内联 style=\"color:#333333\" / style=\"background:#ffffff\" 优先级 1000，\n   普通 CSS 选择器无法压过，必须 !important。 */\nhtml[data-theme=\"dark\"] body{background:#101418!important;color:#e8ecf1}\n/* B3 修复（2026-10-18）：只对明确容器覆盖，保留页面语义色（错/对卡、提示块、标签）\n   —— 无差别压平正文树摧毁 .cmp-wrong/.cmp-right/.flag-* 等语义编码 */\nhtml[data-theme=\"dark\"] body .card,\nhtml[data-theme=\"dark\"] body .panel,\nhtml[data-theme=\"dark\"] body .step,\nhtml[data-theme=\"dark\"] body .scene,\nhtml[data-theme=\"dark\"] body .dict-item,\nhtml[data-theme=\"dark\"] body .card-block,\nhtml[data-theme=\"dark\"] body .cmp-box,\nhtml[data-theme=\"dark\"] body .callout{\n  background:#171c22;border-color:rgba(255,255,255,.09)}\n\n/* 次级文本 / 弱化文字 */\nhtml[data-theme=\"dark\"] body span[style*=\"color:#8\"],\nhtml[data-theme=\"dark\"] body span[style*=\"color:#9\"],\nhtml[data-theme=\"dark\"] body span[style*=\"color:#a\"],\nhtml[data-theme=\"dark\"] body p[style*=\"color:#8\"],\nhtml[data-theme=\"dark\"] body p[style*=\"color:#9\"]{color:#98a3b1!important}\n\n/* 强调色：链接 / 主题色文字 */\nhtml[data-theme=\"dark\"] body a{color:#4f8cff!important}\nhtml[data-theme=\"dark\"] body span[style*=\"color:#0\"],\nhtml[data-theme=\"dark\"] body span[style*=\"color:#1\"],\nhtml[data-theme=\"dark\"] body span[style*=\"color:#2\"],\nhtml[data-theme=\"dark\"] body span[style*=\"color:#3\"]{color:#4f8cff!important}\n\n/* 渐变条 / 彩色横条：背景保留深色化，文字必须白字 */\n/* B4 修复（2026-10-18）：渐变保留色相，只用 brightness 深色化；选择器不限 section */\nhtml[data-theme=\"dark\"] body [style*=\"linear-gradient\"]{\n  filter:brightness(.72) saturate(1.1)}\nhtml[data-theme=\"dark\"] body [style*=\"linear-gradient\"] p,\nhtml[data-theme=\"dark\"] body [style*=\"linear-gradient\"] span,\nhtml[data-theme=\"dark\"] body [style*=\"linear-gradient\"] a{\n  color:rgba(255,255,255,.94)!important}\n\n/* 浅色底块（目录、引用等）在深色下改为深色底 */\nhtml[data-theme=\"dark\"] body section[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body section[style*=\"background-color:#f\"],\nhtml[data-theme=\"dark\"] body div[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body p[style*=\"background:#f\"]{\n  background-color:#1a2027!important;\n  border-color:rgba(255,255,255,.09)!important}\n\n/* 代码块（子页常内联深灰底 + 白字） */\nhtml[data-theme=\"dark\"] body code,\nhtml[data-theme=\"dark\"] body pre{\n  background-color:#1a2027!important;\n  color:#e8ecf1!important}\n\n/* ===== 浅色模式：确认内联白底不被误伤 ===== */\nhtml[data-theme=\"light\"] body{background:#f7f8fa!important}\n/* ===== WCAG-A11Y 专题报告板块对比度修复 2026-09-27 =====\n   正文>=4.5:1 大字>=3:1 映射取站点自身令牌 */\nhtml[data-theme=\"dark\"] body strong,html[data-theme=\"dark\"] body b,\nhtml[data-theme=\"dark\"] body em,html[data-theme=\"dark\"] body i,\nhtml[data-theme=\"dark\"] body u,html[data-theme=\"dark\"] body small,\nhtml[data-theme=\"dark\"] body sub,html[data-theme=\"dark\"] body sup{\n  color:color-mix(in srgb, currentColor 50%, #fff)}\nhtml[data-theme=\"dark\"] body span[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body li[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body td[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body th[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body blockquote[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body figure[style*=\"background:#f\"],\nhtml[data-theme=\"dark\"] body aside[style*=\"background:#f\"]{\n  background-color:#1a2027!important}\nhtml[data-theme=\"dark\"] body *[style*=\"background:#07c160\"],\nhtml[data-theme=\"dark\"] body *[style*=\"background:#07C160\"],\nhtml[data-theme=\"dark\"] body *[style*=\"background:#10c469\"]{\n  background-color:#0b7a54!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#07c160\"],\nhtml[data-theme=\"light\"] body *[style*=\"color:#10c469\"]{color:#0b7a54!important}\nhtml[data-theme=\"light\"] body *[style*=\"background:#07c160\"],\nhtml[data-theme=\"light\"] body *[style*=\"background-color:#07c160\"],\nhtml[data-theme=\"light\"] body *[style*=\"background:#10c469\"]{\n  background-color:#0b7a54!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#e4393c\"]{color:#c81e1e!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#16a34a\"]{color:#15803d!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#1e7e34\"]{color:#155724!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#888888\"],\nhtml[data-theme=\"light\"] body *[style*=\"color:#888\"],\nhtml[data-theme=\"light\"] body *[style*=\"color:#8e8e93\"]{color:#5b6472!important}\nhtml[data-theme=\"light\"] body *[style*=\"color:#e6a23c\"]{color:#7a5b00!important}\n\n\n/* ---- 主题风格层（子页命名空间，由 tools/gen_theme_layer.py 生成）---- */\nhtml[data-style=\"tech\"][data-theme=\"dark\"]{--bg:#101418;--bg2:#15191f;--bg3:#171c22;--card:#171c22;--card-2:#1c222a;--border:rgba(255,255,255,.09);--border-strong:rgba(255,255,255,.16);--text:#e8ecf1;--text2:#98a3b1;--text3:#7d8899;--accent:#4f8cff;--primary:#2563eb;--primary2:#7c3aed;--primary-dark:#2563eb;--chip-bg:#252a2f;--chip-ink:#a8b3c0;--pill-bg:#1f242a;--pill-ink:#a8b3c0;--code-bg:#1a2027;--code-text:#e8ecf1;--danger:#f26d6d;--success:#34d399;--info:#22d3ee;--gradient1:#2563eb;--gradient2:#7c3aed;--gradient3:#22d3ee;--shadow:0 16px 40px rgba(0,0,0,.45)}\nhtml[data-style=\"tech\"][data-theme=\"dark\"] .v2-topbar{border-bottom-color:#3c4045}\nhtml[data-style=\"tech\"][data-theme=\"light\"]{--bg:#f7f8fa;--bg2:#eef0f3;--bg3:#ffffff;--card:#ffffff;--card-2:#fbfcfe;--border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.15);--text:#14181d;--text2:#5b6472;--text3:#666f7d;--accent:#1d4ed8;--primary:#2563eb;--primary2:#7c3aed;--primary-dark:#2563eb;--chip-bg:#f2f2f2;--chip-ink:#4e5764;--pill-bg:#f6f6f6;--pill-ink:#4e5764;--code-bg:#f1f3f6;--code-text:#14181d;--danger:#b52b2b;--success:#0b7a54;--info:#075e69;--gradient1:#2563eb;--gradient2:#7c3aed;--gradient3:#075e69;--shadow:0 16px 40px rgba(0,0,0,.18)}\nhtml[data-style=\"tech\"][data-theme=\"light\"] .v2-topbar{border-bottom-color:#d9d9d9}\nhtml[data-style=\"minimal\"][data-theme=\"dark\"]{--bg:#0a0b0c;--bg2:#101113;--bg3:#131517;--card:#131517;--card-2:#191b1e;--border:rgba(255,255,255,.13);--border-strong:rgba(255,255,255,.30);--text:#f4f5f7;--text2:#adb3bd;--text3:#8b929d;--accent:#8fb3ea;--primary:#e6e9ee;--primary2:#b8bfc9;--primary-dark:#e6e9ee;--chip-bg:#26282a;--chip-ink:#b6bcc6;--pill-bg:#1e2021;--pill-ink:#b6bcc6;--code-bg:#191b1e;--code-text:#f4f5f7;--danger:#e08e8e;--success:#8dc9a8;--info:#8fb8cf;--gradient1:#e6e9ee;--gradient2:#b8bfc9;--gradient3:#8fb8cf;--shadow:0 14px 34px rgba(0,0,0,.5)}\nhtml[data-style=\"minimal\"][data-theme=\"dark\"] .v2-topbar{border-bottom-color:#5a5b5d}\nhtml[data-style=\"minimal\"][data-theme=\"light\"]{--bg:#ffffff;--bg2:#f4f5f6;--bg3:#ffffff;--card:#ffffff;--card-2:#fafbfc;--border:rgba(0,0,0,.13);--border-strong:rgba(0,0,0,.30);--text:#0d0f11;--text2:#4b5158;--text3:#63696f;--accent:#0b5cad;--primary:#17191c;--primary2:#454b52;--primary-dark:#17191c;--chip-bg:#ededed;--chip-ink:#454b52;--pill-bg:#f5f5f5;--pill-ink:#454b52;--code-bg:#f1f2f4;--code-text:#0d0f11;--danger:#a92d26;--success:#0c6b48;--info:#0a6572;--gradient1:#17191c;--gradient2:#454b52;--gradient3:#0a6572;--shadow:0 14px 34px rgba(0,0,0,.14)}\nhtml[data-style=\"minimal\"][data-theme=\"light\"] .v2-topbar{border-bottom-color:#b2b2b2}\nhtml[data-style=\"warm\"][data-theme=\"dark\"]{--bg:#16120f;--bg2:#1c1713;--bg3:#211a15;--card:#211a15;--card-2:#292118;--border:rgba(255,228,196,.13);--border-strong:rgba(255,228,196,.30);--text:#f7ece0;--text2:#c9b49c;--text3:#a28d74;--accent:#f0a860;--primary:#f0a860;--primary2:#d97a34;--primary-dark:#f0a860;--chip-bg:#352c25;--chip-ink:#d3bfa6;--pill-bg:#2c241e;--pill-ink:#d3bfa6;--code-bg:#241c16;--code-text:#f7ece0;--danger:#e2705f;--success:#9ec97e;--info:#7fb6a8;--gradient1:#f0a860;--gradient2:#d97a34;--gradient3:#7fb6a8;--shadow:0 16px 40px rgba(40,24,10,.5)}\nhtml[data-style=\"warm\"][data-theme=\"dark\"] .v2-topbar{border-bottom-color:#64574a}\nhtml[data-style=\"warm\"][data-theme=\"light\"]{--bg:#fbf5ec;--bg2:#f4ead9;--bg3:#fffdf8;--card:#fffdf8;--card-2:#fdf7ee;--border:rgba(90,58,26,.14);--border-strong:rgba(90,58,26,.28);--text:#2b211a;--text2:#6b5847;--text3:#7d6653;--accent:#a04d10;--primary:#a04d10;--primary2:#8a3a1e;--primary-dark:#a04d10;--chip-bg:#f0ebe4;--chip-ink:#5d4c3c;--pill-bg:#f7f3ed;--pill-ink:#5d4c3c;--code-bg:#f0e6d6;--code-text:#2b211a;--danger:#b33424;--success:#356a26;--info:#0f6f63;--gradient1:#a04d10;--gradient2:#8a3a1e;--gradient3:#0f6f63;--shadow:0 18px 44px rgba(120,80,40,.22)}\nhtml[data-style=\"warm\"][data-theme=\"light\"] .v2-topbar{border-bottom-color:#d1c6ba}\nhtml[data-style=\"pro\"][data-theme=\"dark\"]{--bg:#0f1420;--bg2:#131a28;--bg3:#151c2b;--card:#151c2b;--card-2:#1c2536;--border:rgba(150,180,255,.12);--border-strong:rgba(150,180,255,.28);--text:#dfe6f2;--text2:#9aa7bd;--text3:#7e8ca3;--accent:#6ea8fe;--primary:#7aa2f7;--primary2:#4fd1c5;--primary-dark:#7aa2f7;--chip-bg:#1e283e;--chip-ink:#a7b4c9;--pill-bg:#1a2336;--pill-ink:#a7b4c9;--code-bg:#111826;--code-text:#dfe6f2;--danger:#f07178;--success:#56d364;--info:#4fd1c5;--gradient1:#7aa2f7;--gradient2:#4fd1c5;--gradient3:#4fd1c5;--shadow:0 16px 40px rgba(3,7,18,.6)}\nhtml[data-style=\"pro\"][data-theme=\"dark\"] .v2-topbar{border-bottom-color:#394766}\nhtml[data-style=\"pro\"][data-theme=\"light\"]{--bg:#f2f4f8;--bg2:#e6eaf1;--bg3:#ffffff;--card:#ffffff;--card-2:#f7f9fc;--border:rgba(15,26,43,.12);--border-strong:rgba(15,26,43,.26);--text:#0f1a2b;--text2:#4d5a70;--text3:#5f6b7f;--accent:#0f62fe;--primary:#0f62fe;--primary2:#006d6e;--primary-dark:#0f62fe;--chip-bg:#e9eaec;--chip-ink:#43505f;--pill-bg:#f3f4f4;--pill-ink:#43505f;--code-bg:#eef1f6;--code-text:#0f1a2b;--danger:#c1322a;--success:#0f7a52;--info:#0072a3;--gradient1:#0f62fe;--gradient2:#006d6e;--gradient3:#0072a3;--shadow:0 16px 40px rgba(7,17,33,.16)}\nhtml[data-style=\"pro\"][data-theme=\"light\"] .v2-topbar{border-bottom-color:#c1c3c8}\n\n/* ---- 子页风格切换入口（桌面并进顶部返回栏 / 移动端右下胶囊）---- */\n.v2-topbar-style{display:inline-flex;align-items:center;gap:5px;margin-left:6px;\npadding:5px 10px;border-radius:8px;border:1px solid var(--border-strong);\nbackground:transparent;color:var(--text);font:inherit;font-size:12px;font-weight:600;\ncursor:pointer;min-height:32px;white-space:nowrap}\n.v2-topbar-style:hover{background:var(--card)}\n.v2-topbar-style .v2-fab-txt{font-size:12px;font-weight:600;line-height:1}\n#v2-style-fab{position:fixed;right:calc(env(safe-area-inset-right) + 16px);\nbottom:calc(env(safe-area-inset-bottom) + 68px);z-index:9999;display:inline-flex;\nalign-items:center;justify-content:center;gap:5px;padding:0 14px;width:auto;\nmin-width:44px;height:44px;border-radius:22px;border:1px solid var(--border-strong);\ncolor:var(--text);font:inherit;font-size:13px;cursor:pointer;\nbackground:color-mix(in srgb,var(--card) 88%,transparent);box-shadow:var(--shadow);\n-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}\n#v2-style-fab:hover{transform:translateY(-2px)}\n#v2-style-fab .v2-fab-txt{font-size:13px;font-weight:600;line-height:1}\n/* #460-7：基态已 display:inline-flex，全端显示浮钮（topbar 已于 2026-10-11 移除） */\n\n@media print{.v2-topbar-style,#v2-style-fab{display:none!important}}\n\n/* ---- 移动端专项（MOBILE-POLISH-SUBPAGES，2026-10-10）----\n   ⚠️ 本块必须写在生成器里，不能手改 patch_subpages_theme.py 的 STYLE_LAYER ——\n      write_patch() 用 re.S 整体替换该常量，手改会被下次生成抹掉。\n   实测（真实浏览器 320/375/390/414/430 五档）：\n     · #v2-style-fab 只有 22×21，远不到 44×44\n       根因：按钮内容是两个 span（emoji + 文字标签），paint() 在无标签时\n       把 .v2-fab-txt 留空 → flex 容器无内容撑开，且 height:44px 被\n       「内容为空 + 无 min-height 兜底」压回内容高度。\n       修法：min-height + flex-shrink:0 + 固定图标尺寸，三者齐备才不塌。\n     · 注入层出现 11.5px 字号，移动端正文不低于 12px。*/\n@media (max-width:900px){\n  #v2-style-fab,#v2-theme-fab,#v2-home-fab{\n    /* ⚠️ 这三个必须 !important：内容页自带内联 <style> 里有\n       `#v2-style-fab{...}` 之类更高优先级或后写入的规则，\n       实测不加时按钮只有 22×21（内容塌陷，非 CSS 缺陷而是 flex 无内容撑开）。\n       min-height 与固定 icon 尺寸齐备才不塌。 */\n    min-width:44px!important;min-height:44px!important;height:44px!important;\n    width:auto;box-sizing:border-box;flex-shrink:0;\n    align-items:center;justify-content:center}\n  #v2-style-fab{width:44px!important;padding:0!important}\n  #v2-style-fab .v2-fab-txt{display:none!important}\n  #v2-style-fab span[aria-hidden]{font-size:16px!important;line-height:1!important;display:block!important}\n  .v2-topbar-style{min-height:44px;padding:0 14px;font-size:13px}\n  #v2-topbar,.v2-topbar a,.v2-topbar button{font-size:12px}\n  .v2-fab-txt{font-size:12px}\n  /* 子页表格与代码：移动端字号下限 12px。\n     ⚠️ 必须 !important —— 内容页（server-diy/*.html 等）大量使用\n     **内联 style 属性**（style=\"font-size:11.5px\"），\n     内联样式特异性高于任何选择器，不加 !important 一律盖不住。\n     实测：11.5px 的表格数字与结论短句在 320px 上已难辨认。 */\n  /* B2 修复（2026-10-18）：收窄到表格/代码类，不再压平正文 p/li */\n  table:not(.table-wrap table) td,\n  table:not(.table-wrap table) th,\n  .mono,.kpi .k,.kpi .d,.badge,.sub,.k,.d{font-size:12px}\n  /* 表格移动端兜底：不破坏布局，只限制宽度（2026-10-18 B1 修复：display:block 使 table-layout:fixed 失效） */\n  table{max-width:100%!important;width:100%!important;border-collapse:collapse}\n}\n\n/*v2-dark-legacy-ctrl*/ /* 深色模式：页面自带的浅色控件需跟随主题。\n   全站逐页审计发现 1200+ 页共性问题 —— 旧日报页自带 .theme-toggle（硬编码\n   background:#fff，深色下白底刺眼），以及风格切换钮 .v2-style-fab 底色偏浅。\n   子页变量是 --card/--text/--border-strong（不是 --v2-*），见子页注入三铁律。 */\nhtml[data-theme=\"dark\"] .theme-toggle{background:var(--card,#171c22)!important;\n  color:var(--text,#e8ecf1)!important;border-color:var(--border-strong,rgba(255,255,255,.16))!important}\nhtml[data-theme=\"dark\"] .v2-style-fab{background:var(--card,#171c22)!important;\n  color:var(--text,#e8ecf1)!important}\n@media (max-width:640px){\n  .theme-toggle{width:44px!important;height:44px!important}\n}\n\n/*v2-dark-bg-override*/ /* 深色模式：内联硬编码浅色背景兜底（第二版）。\n   全站逐页审计（1228 页）发现 1168 页在深色模式下有浅色背景（95%）。\n   ⚠️ 第一版写的是 [style*=\"background:#fff\"]，只命中 background: 简写，\n      漏掉 background-color: 写法 —— dating-guide 的 1086 处一处没变。\n      属性选择器是子串匹配，直接匹配颜色值能覆盖所有写法\n      （background / background-color / border-color 都能命中）。\n      副作用可控：白字元素被改深底后仍是白字，依然可读。 */\nhtml[data-theme=\"dark\"] [style*=\"#fff\"],\nhtml[data-theme=\"dark\"] [style*=\"#ffffff\"],\nhtml[data-theme=\"dark\"] [style*=\"white\"],\nhtml[data-theme=\"dark\"] [style*=\"rgb(255\"],\nhtml[data-theme=\"dark\"] [style*=\"#f7f8fa\"],\nhtml[data-theme=\"dark\"] [style*=\"#fafafa\"],\nhtml[data-theme=\"dark\"] [style*=\"#f5f5f5\"],\nhtml[data-theme=\"dark\"] [style*=\"#f8f9fa\"],\nhtml[data-theme=\"dark\"] [style*=\"#fbfbfb\"]{\n  background-color:var(--card,#171c22)!important;\n  color:var(--text,#e8ecf1)!important;\n}\n/* 浅色模式反向兜底：避免深色硬编码在浅色下变成黑底 */\nhtml[data-theme=\"light\"] [style*=\"background:#101418\"],\nhtml[data-theme=\"light\"] [style*=\"background:#171c22\"],\nhtml[data-theme=\"light\"] [style*=\"background:#1a1a1a\"]{\n  background-color:var(--card,#fff)!important;\n  color:var(--text,#14181d)!important;\n}\n"],"\n"],"\n",["BODY",{},["MAIN",{"style":"display:contents"},"\n","\n\n",["CANVAS",{"__playwright_bounding_rect__":"{\"left\":0,\"top\":0,\"right\":1440,\"bottom\":900}","id":"c","data-engine":"three.js r160","width":"1440","height":"900","style":"width: 1440px; height: 900px; touch-action: none;"}],"\n\n","\n",["HEADER",{"id":"panel-title","class":"panel"},"\n  ",["H1",{},["SPAN",{"class":"dot"}],"城市地铁 · 地下三维视图\n    ",["SPAN",{"class":"h1-tools"},"\n      ",["BUTTON",{"class":"h1-btn","id":"btn-share","title":"分享当前视图"},"⤴"],"\n      ",["BUTTON",{"class":"h1-btn","id":"btn-title-toggle","title":"展开/收起详情"},"▾"],"\n    "],"\n  "],"\n  ",["DIV",{"class":"sel-row"},"\n    ",["SELECT",{"id":"sel-city","title":"选择城市"},["OPTGROUP",{"label":"主要线网（≥10 线）"},["OPTION",{"__playwright_selected_":"false","value":"beijing"},"北京（27线/527站）"],["OPTION",{"__playwright_selected_":"true","value":"shanghai"},"上海（24线/536站）"],["OPTION",{"__playwright_selected_":"false","value":"guangzhou"},"广州（23线/418站）"],["OPTION",{"__playwright_selected_":"false","value":"chengdu"},"成都（18线/476站）"],["OPTION",{"__playwright_selected_":"false","value":"chongqing"},"重庆（16线/345站）"],["OPTION",{"__playwright_selected_":"false","value":"hangzhou"},"杭州（16线/394站）"],["OPTION",{"__playwright_selected_":"false","value":"shenzhen"},"深圳（16线/432站）"],["OPTION",{"__playwright_selected_":"false","value":"nanjing"},"南京（15线/303站）"],["OPTION",{"__playwright_selected_":"false","value":"tianjin"},"天津（14线/275站）"],[